
[Unit]
Description=theairtraffic-mlat
Wants=network.target
After=network.target

[Service]
EnvironmentFile=/etc/default/theairtraffic
ExecStart=/usr/local/share/theairtraffic/venv/bin/python3 /usr/local/share/theairtraffic/venv/bin/mlat-client \
	--input-type $INPUT_TYPE --no-udp \
	--input-connect $INPUT \
	--server $MLATSERVER \
	--user $USER \
	--lat $RECEIVERLATITUDE \
	--lon $RECEIVERLONGITUDE \
	--alt $RECEIVERALTITUDE \
	$RESULTS
Type=simple
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=64
SyslogIdentifier=theairtraffic-mlat

[Install]
WantedBy=default.target
