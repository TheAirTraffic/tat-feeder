
[Unit]
Description=theairtraffic-mlat
Wants=network.target
After=network.target

[Service]
EnvironmentFile=/etc/default/theairtraffic
ExecStart=/usr/bin/mlat-client \
	--input-type dump1090 --no-udp \
	--input-connect localhost:30005 \
	--server $MLATSERVER \
	--user $USER \
	--lat $RECEIVERLATITUDE \
	--lon $RECEIVERLONGITUDE \
	--alt $RECEIVERALTITUDE \
	--results $RESULTS
Type=simple
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=64
SyslogIdentifier=theairtraffic-mlat

[Install]
WantedBy=default.target
