
[Unit]
Description=theairtraffic-mlat
Wants=network.target
After=network.target

[Service]
EnvironmentFile=/etc/default/theairtraffic
ExecStart=/usr/local/bin/TheAirTraffic/mlat-client/mlat-client \
	--input-type $INPUT_TYPE --no-udp \
	--input-connect $INPUT \
	--server $MLATSERVER \
	--user $USER \
	--lat $RECEIVERLATITUDE \
	--lon $RECEIVERLONGITUDE \
	--alt $RECEIVERALTITUDE \
	$RESULTS
Type=simple
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=64
SyslogIdentifier=theairtraffic-mlat

[Install]
WantedBy=default.target
